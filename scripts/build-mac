#!/usr/bin/env bash
# Builds the iPadOS app for Apple Silicon Macs ("Designed for iPad") and exports
# a development-signed ios/build/export/JetKVM.ipa. With --install, opens the
# .ipa, which installs the app into /Applications.
#
# The Mac must be registered in the team's provisioning profile; the first run
# registers it automatically (-allowProvisioningDeviceRegistration).
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

install=false
for arg in "$@"; do
  case "$arg" in
    --install) install=true ;;
    *) echo "usage: scripts/build-mac [--install]" >&2; exit 2 ;;
  esac
done

if [[ "$(uname -m)" != "arm64" ]]; then
  echo "iPad apps only run on Apple Silicon Macs" >&2
  exit 1
fi

scripts/build-ios

cd ios
rm -rf build/JetKVM.xcarchive build/export
# Archiving for generic iOS never registers this Mac, so build once for the
# "Designed for iPad" destination to add it to the provisioning profile.
xcodebuild build \
  -project JetKVM.xcodeproj \
  -scheme JetKVM \
  -configuration Release \
  -destination 'platform=macOS,arch=arm64,variant=Designed for iPad' \
  -derivedDataPath build/DerivedData-mac \
  -allowProvisioningUpdates \
  -allowProvisioningDeviceRegistration \
  -quiet
xcodebuild archive \
  -project JetKVM.xcodeproj \
  -scheme JetKVM \
  -configuration Release \
  -destination 'generic/platform=iOS' \
  -archivePath build/JetKVM.xcarchive \
  -allowProvisioningUpdates \
  -allowProvisioningDeviceRegistration \
  -quiet
xcodebuild -exportArchive \
  -archivePath build/JetKVM.xcarchive \
  -exportPath build/export \
  -exportOptionsPlist ExportOptions-mac.plist \
  -allowProvisioningUpdates \
  -quiet
echo "Built ios/build/export/JetKVM.ipa"

if "$install"; then
  # Installing over an existing copy adds "JetKVM 2.app" instead of upgrading
  # it, and the root-owned wrapper can't be removed without authorization, so
  # quit the app and have Finder move old copies to the Trash (it may ask for
  # an administrator password).
  osascript -e 'quit app "JetKVM"' 2>/dev/null || true
  # Quitting needs permission to control JetKVM, which the terminal may not
  # have been granted; without a fallback the wait below never ends.
  for _ in $(seq 20); do
    pgrep -f '/Wrapper/JetKVM.app/JetKVM$' >/dev/null || break
    sleep 0.5
  done
  pkill -f '/Wrapper/JetKVM.app/JetKVM$' 2>/dev/null || true
  while pgrep -f '/Wrapper/JetKVM.app/JetKVM$' >/dev/null; do sleep 0.5; done
  for app in /Applications/JetKVM.app /Applications/JetKVM\ [0-9]*.app; do
    [[ -e "$app" ]] || continue
    # Deleting the root-owned wrapper needs an administrator password, and the
    # prompt outlives the two minutes an AppleEvent waits by default. Finder
    # applies a limit of its own on top of this, so a prompt left sitting still
    # fails with -1712; answer it when it appears.
    osascript -e "with timeout of 600 seconds" \
      -e "tell application \"Finder\" to delete POSIX file \"$app\"" \
      -e "end timeout" >/dev/null
  done
  # A still-open installer window from an earlier failed install ignores the
  # next open, so the new .ipa would silently not be installed.
  pkill -x 'iOS App Installer' 2>/dev/null || true
  open build/export/JetKVM.ipa
  echo "Installing into /Applications/JetKVM.app"
fi
